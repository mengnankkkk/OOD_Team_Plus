DEEPSEEK_API_KEY=your_value_here
DEEPSEEK_MODEL=default_placeholder
DEEPSEEK_API_URL=your_value_here
DEFAULT_USERNAME=your_value_here
DEFAULT_PASSWORD=your_value_here
JAVA_SERVICE_BASE_URL=your_value_here
PANDADATA_PYTHON=/opt/pandadata-venv/bin/python
DB_PATH=/app/data/money-whisperer.db
APP_ORIGIN=your_production_origin_or_comma_separated_origins
# Temporary legacy bootstrap token; provision normal A2A clients through the administrator API.
A2A_BEARER_TOKEN=your_temporary_legacy_bootstrap_token
# Optional client-specific token provisioned at startup; store only in a secret manager.
A2A_BOOTSTRAP_CLIENT_TOKEN=your_mwa2a_bootstrap_client_token
# Initial A2A response wait budget; longer tasks continue asynchronously and are polled by task ID.
A2A_INITIAL_RESPONSE_TIMEOUT_MS=750
ADMIN_USERNAME=admin_placeholder
ADMIN_INITIAL_PASSWORD=your_value_here
ALLOW_REGISTRATION=true
MCP_SEARCH_URL=your_value_here
FIRECRAWL_API_KEY=your_value_here
FIRECRAWL_SEARCH_URL=https://api.firecrawl.dev/v2/search
HOST_BIND_ADDRESS=0.0.0.0
HOST_PORT=3000
DEPLOY_HOST=your_server_host
DEPLOY_PORT=22
DEPLOY_USER=your_ssh_user
DEPLOY_PASSWORD=your_ssh_password
DEPLOY_PATH=/opt/money-whisperer
